    "numerical_features_full = raw_num + engineered_num\n",
    "categorical_features_full = raw_cat + engineered_cat\n",
    "\n",
    "def make_preprocessor(scale, num_feats=None, cat_feats=None):\n",
    "    num_feats = num_feats if num_feats is not None else numerical_features_full\n",
    "    cat_feats = cat_feats if cat_feats is not None else categorical_features_full\n",
    "    num_steps = [(\"imputer\", SimpleImputer(strategy=\"median\"))]\n",
    "    if scale:\n",
    "        num_steps.append((\"scaler\", StandardScaler()))\n",
    "    num_pipe = Pipeline(num_steps)\n",
    "    cat_pipe = Pipeline([\n",
    "        (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "        (\"ohe\", OneHotEncoder(handle_unknown=\"ignore\"))\n",
    "    ])\n",
    "    return ColumnTransformer([(\"num\", num_pipe, num_feats), (\"cat\", cat_pipe, cat_feats)])\n",
    "\n",
    "def get_models():\n",
    "    return {\n",
    "        \"Logistic Regression\": (LogisticRegression(max_iter=2000, random_state=RANDOM_STATE), True),\n",
    "        \"Decision Tree\": (DecisionTreeClassifier(random_state=RANDOM_STATE), False),\n",
    "        \"Random Forest\": (RandomForestClassifier(n_estimators=300, random_state=RANDOM_STATE, n_jobs=-1), False),\n",
    "        \"XGBoost\": ((XGBClassifier(n_estimators=300, random_state=RANDOM_STATE, eval_metric=\"logloss\")\n",
    "                     if XGB_AVAILABLE else HistGradientBoostingClassifier(random_state=RANDOM_STATE)), False),\n",
    "        \"Gradient Boosting\": (GradientBoostingClassifier(random_state=RANDOM_STATE), False),\n",
    "    }\n",
    "\n",
    "def build_pipeline(model, scale, num_feats=None, cat_feats=None):\n",
    "    return Pipeline([(\"preprocess\", make_preprocessor(scale, num_feats, cat_feats)), (\"model\", model)])\n",
    "\n",
    "def evaluate_on_holdout(pipe, X_tr, y_tr, X_val, y_val):\n",
    "    pipe.fit(X_tr, y_tr)\n",
    "    proba = pipe.predict_proba(X_val)[:, 1]\n",
    "    pred = (proba >= 0.5).astype(int)\n",
    "    return {\n",
    "        \"accuracy\": accuracy_score(y_val, pred), \"precision\": precision_score(y_val, pred),\n",
    "        \"recall\": recall_score(y_val, pred), \"f1\": f1_score(y_val, pred),\n",
    "        \"roc_auc\": roc_auc_score(y_val, proba),\n",
    "    }\n",
    "\n",
    "X_tr, X_val, y_tr, y_val = train_test_split(X_train, y_train, test_size=0.20, stratify=y_train, random_state=RANDOM_STATE)\n",
    "\n",
    "baseline_results = {}\n",
    "for name, (model, scale) in get_models().items():\n",
    "    pipe = build_pipeline(model, scale)\n",
    "    baseline_results[name] = evaluate_on_holdout(pipe, X_tr, y_tr, X_val, y_val)\n",
    "\n",
    "baseline_df = pd.DataFrame(baseline_results).T.round(4)\n",
    "print(\"=== Iteration 1: Baseline (all engineered features, no imbalance handling) ===\")\n",
    "baseline_df\n"
   ]
