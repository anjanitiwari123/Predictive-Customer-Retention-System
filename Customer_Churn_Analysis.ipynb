    "\n",
    "def quick_cv_auc(X_data, y_data, num_feats, cat_feats, scale=True):\n",
    "    pre = ColumnTransformer([\n",
    "        (\"num\", Pipeline([(\"imputer\", SimpleImputer(strategy=\"median\"))] + ([(\"scaler\", StandardScaler())] if scale else [])), num_feats),\n",
    "        (\"cat\", Pipeline([(\"imputer\", SimpleImputer(strategy=\"most_frequent\")), (\"ohe\", OneHotEncoder(handle_unknown=\"ignore\"))]), cat_feats),\n",
    "    ])\n",
    "    pipe = Pipeline([(\"pre\", pre), (\"model\", LogisticRegression(max_iter=2000, random_state=RANDOM_STATE))])\n",
    "    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
    "    scores = cross_validate(pipe, X_data, y_data, cv=cv, scoring=\"roc_auc\")\n",
    "    return scores[\"test_score\"].mean()\n",
    "\n",
    "raw_num_check = [\"tenure\", \"MonthlyCharges\", \"TotalCharges\"]\n",
    "cat_check = [c for c in df.columns if c not in raw_num_check + [\"Churn\"]]\n",
    "\n",
    "X_check = df.drop(columns=[\"Churn\"]).copy()\n",
    "y_check = df[\"Churn\"]\n",
    "\n",
    "auc_no_transform = quick_cv_auc(X_check, y_check, raw_num_check, cat_check)\n",
    "\n",
    "X_check_log = X_check.copy()\n",
    "X_check_log[\"TotalCharges\"] = np.log1p(X_check_log[\"TotalCharges\"])\n",
    "auc_with_log = quick_cv_auc(X_check_log, y_check, raw_num_check, cat_check)\n",
    "\n",
    "print(f\"Logistic Regression CV roc_auc WITHOUT log1p(TotalCharges): {auc_no_transform:.4f}\")\n",
    "print(f\"Logistic Regression CV roc_auc WITH    log1p(TotalCharges): {auc_with_log:.4f}\")\n"
   ]
