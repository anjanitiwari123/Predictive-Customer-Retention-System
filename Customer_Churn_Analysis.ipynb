   "source": [
    "FINAL_THRESHOLD = 0.55\n",
    "\n",
    "final_preprocessor = make_preprocessor(True, numerical_features, categorical_features)\n",
    "X_train_enc = final_preprocessor.fit_transform(X_train)\n",
    "if hasattr(X_train_enc, \"toarray\"):\n",
    "    X_train_enc = X_train_enc.toarray()\n",
    "\n",
    "if IMBLEARN_AVAILABLE:\n",
    "    X_train_res, y_train_res = ImblearnSMOTE(random_state=RANDOM_STATE).fit_resample(X_train_enc, y_train)\n",
    "else:\n",
    "    X_train_res, y_train_res = simple_smote(X_train_enc, y_train.values)\n",
    "\n",
    "final_model = LogisticRegression(max_iter=2000, random_state=RANDOM_STATE, C=FINAL_C, penalty=FINAL_PENALTY, solver=FINAL_SOLVER)\n",
    "final_model.fit(X_train_res, y_train_res)\n",
    "\n",
    "# Inference-ready pipeline: preprocessing + model. SMOTE is a training-only\n",
    "# step and is intentionally NOT part of the saved inference pipeline.\n",
    "final_pipeline = Pipeline([(\"preprocess\", final_preprocessor), (\"model\", final_model)])\n",
    "\n",
    "test_proba = final_pipeline.predict_proba(X_test)[:, 1]\n",
    "test_pred = (test_proba >= FINAL_THRESHOLD).astype(int)\n",
    "\n",
    "final_test_metrics = {\n",
    "    \"accuracy\": accuracy_score(y_test, test_pred), \"precision\": precision_score(y_test, test_pred),\n",
    "    \"recall\": recall_score(y_test, test_pred), \"f1\": f1_score(y_test, test_pred),\n",
    "    \"roc_auc\": roc_auc_score(y_test, test_proba),\n",
    "}\n",
    "print(\"=== FINAL TEST SET METRICS (evaluated once) ===\")\n",
    "for k, v in final_test_metrics.items():\n",
    "    print(f\"{k}: {v:.4f}\")\n"
   ]
  },
