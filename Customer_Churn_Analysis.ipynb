   "source": [
    "rng = np.random.RandomState(RANDOM_STATE)\n",
    "param_grid = [{\"C\": 10 ** rng.uniform(-3, 2), \"penalty\": rng.choice([\"l2\", \"l1\"])} for _ in range(12)]\n",
    "\n",
    "tuning_results = []\n",
    "for params in param_grid:\n",
    "    solver = \"liblinear\" if params[\"penalty\"] == \"l1\" else \"lbfgs\"\n",
    "    ctor = lambda p=params, s=solver: LogisticRegression(max_iter=2000, random_state=RANDOM_STATE, C=p[\"C\"], penalty=p[\"penalty\"], solver=s)\n",
    "    aucs, f1s = cv_with_smote(ctor, True, X_train, y_train, n_splits=5)\n",
    "    tuning_results.append({**params, \"roc_auc_mean\": aucs.mean(), \"f1_mean\": f1s.mean()})\n",
    "\n",
    "tuning_df = pd.DataFrame(tuning_results).sort_values(\"roc_auc_mean\", ascending=False).round(4)\n",
    "tuning_df\n"
   ]
