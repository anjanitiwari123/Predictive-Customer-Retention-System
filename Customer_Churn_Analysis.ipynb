   "source": [
    "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
    "oof_proba = np.zeros(len(X_train))\n",
    "y_train_arr = y_train.values\n",
    "for tr_idx, va_idx in skf.split(X_train, y_train):\n",
    "    Xtr_fold, Xva_fold = X_train.iloc[tr_idx], X_train.iloc[va_idx]\n",
    "    ytr_fold = y_train.iloc[tr_idx]\n",
    "    pre = make_preprocessor(True, numerical_features, categorical_features)\n",
    "    Xtr_enc = pre.fit_transform(Xtr_fold)\n",
    "    Xva_enc = pre.transform(Xva_fold)\n",
    "    if hasattr(Xtr_enc, \"toarray\"):\n",
    "        Xtr_enc, Xva_enc = Xtr_enc.toarray(), Xva_enc.toarray()\n",
    "    if IMBLEARN_AVAILABLE:\n",
    "        Xres, yres = ImblearnSMOTE(random_state=RANDOM_STATE).fit_resample(Xtr_enc, ytr_fold)\n",
    "    else:\n",
    "        Xres, yres = simple_smote(Xtr_enc, ytr_fold.values)\n",
    "    m = LogisticRegression(max_iter=2000, random_state=RANDOM_STATE, C=FINAL_C, penalty=FINAL_PENALTY, solver=FINAL_SOLVER)\n",
    "    m.fit(Xres, yres)\n",
    "    oof_proba[va_idx] = m.predict_proba(Xva_enc)[:, 1]\n",
    "\n",
    "thresholds = [0.20,0.25,0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70]\n",
    "thresh_rows = []\n",
    "for t in thresholds:\n",
    "    pred = (oof_proba >= t).astype(int)\n",
    "    thresh_rows.append({\"threshold\": t, \"precision\": precision_score(y_train_arr, pred),\n",
    "                         \"recall\": recall_score(y_train_arr, pred), \"f1\": f1_score(y_train_arr, pred),\n",
    "                         \"accuracy\": accuracy_score(y_train_arr, pred)})\n",
    "thresh_df = pd.DataFrame(thresh_rows).round(4)\n",
    "thresh_df\n"
   ]
  },
