    "def simple_smote(X_num, y, k=5, random_state=RANDOM_STATE):\n",
    "    \"\"\"Hand-written SMOTE, used only when imblearn is unavailable. Interpolates\n",
    "    between each minority sample and one of its k nearest minority neighbours.\"\"\"\n",
    "    rng = np.random.RandomState(random_state)\n",
    "    X_num = np.asarray(X_num)\n",
    "    classes, counts = np.unique(y, return_counts=True)\n",
    "    minority_class = classes[np.argmin(counts)]\n",
    "    n_to_generate = counts.max() - counts.min()\n",
    "\n",
    "    X_min = X_num[y == minority_class]\n",
    "    nn = NearestNeighbors(n_neighbors=min(k + 1, len(X_min))).fit(X_min)\n",
    "    _, neighbors = nn.kneighbors(X_min)\n",
    "\n",
    "    synthetic = []\n",
    "    for _ in range(n_to_generate):\n",
    "        i = rng.randint(0, len(X_min))\n",
    "        nbr_choices = neighbors[i][1:] if neighbors.shape[1] > 1 else neighbors[i]\n",
    "        j = nbr_choices[rng.randint(0, len(nbr_choices))]\n",
    "        gap = rng.rand()\n",
    "        synthetic.append(X_min[i] + gap * (X_min[j] - X_min[i]))\n",
    "    synthetic = np.array(synthetic)\n",
    "    X_res = np.vstack([X_num, synthetic])\n",
    "    y_res = np.concatenate([y, np.full(len(synthetic), minority_class)])\n",
    "    return X_res, y_res\n",
    "\n",
    "if IMBLEARN_AVAILABLE:\n",
    "    from imblearn.pipeline import Pipeline as ImbPipeline\n",
    "\n",
    "def evaluate_with_smote(model, scale, X_tr, y_tr, X_val, y_val, num_feats=None, cat_feats=None):\n",
    "    pre = make_preprocessor(scale, num_feats, cat_feats)\n",
    "    X_tr_enc = pre.fit_transform(X_tr)\n",
    "    X_val_enc = pre.transform(X_val)\n",
    "    if hasattr(X_tr_enc, \"toarray\"):\n",
    "        X_tr_enc, X_val_enc = X_tr_enc.toarray(), X_val_enc.toarray()\n",
    "    if IMBLEARN_AVAILABLE:\n",
    "        X_res, y_res = ImblearnSMOTE(random_state=RANDOM_STATE).fit_resample(X_tr_enc, y_tr)\n",
    "    else:\n",
    "        X_res, y_res = simple_smote(X_tr_enc, y_tr.values)\n",
    "    model.fit(X_res, y_res)\n",
    "    proba = model.predict_proba(X_val_enc)[:, 1]\n",
    "    pred = (proba >= 0.5).astype(int)\n",
    "    return {\n",
    "        \"accuracy\": accuracy_score(y_val, pred), \"precision\": precision_score(y_val, pred),\n",
    "        \"recall\": recall_score(y_val, pred), \"f1\": f1_score(y_val, pred),\n",
    "        \"roc_auc\": roc_auc_score(y_val, proba),\n",
    "    }\n",
    "\n",
    "# Experiment 2: class_weight='balanced' where supported\n",
    "cw_results = {}\n",
    "cw_models = {\n",
    "    \"Logistic Regression\": (LogisticRegression(max_iter=2000, random_state=RANDOM_STATE, class_weight=\"balanced\"), True),\n",
    "    \"Decision Tree\": (DecisionTreeClassifier(random_state=RANDOM_STATE, class_weight=\"balanced\"), False),\n",
    "    \"Random Forest\": (RandomForestClassifier(n_estimators=300, random_state=RANDOM_STATE, n_jobs=-1, class_weight=\"balanced\"), False),\n",
    "    \"XGBoost\": ((XGBClassifier(n_estimators=300, random_state=RANDOM_STATE, eval_metric=\"logloss\",\n",
    "                                scale_pos_weight=(y_tr==0).sum()/(y_tr==1).sum())\n",
    "                 if XGB_AVAILABLE else HistGradientBoostingClassifier(random_state=RANDOM_STATE, class_weight=\"balanced\")), False),\n",
    "    \"Gradient Boosting\": (GradientBoostingClassifier(random_state=RANDOM_STATE), False),  # no native class_weight\n",
    "}\n",
    "for name, (model, scale) in cw_models.items():\n",
    "    pipe = build_pipeline(model, scale)\n",
    "    cw_results[name] = evaluate_on_holdout(pipe, X_tr, y_tr, X_val, y_val)\n",
    "cw_df = pd.DataFrame(cw_results).T.round(4)\n",
    "\n",
    "# Experiment 3: SMOTE\n",
    "smote_results = {}\n",
    "for name, (model, scale) in get_models().items():\n",
    "    smote_results[name] = evaluate_with_smote(clone(model), scale, X_tr, y_tr, X_val, y_val)\n",
    "smote_df = pd.DataFrame(smote_results).T.round(4)\n",
    "\n",
    "print(\"=== Experiment 1: no imbalance handling ===\")\n",
    "print(baseline_df)\n",
    "print(\"\\n=== Experiment 2: class_weight='balanced' ===\")\n",
    "print(cw_df)\n",
    "print(\"\\n=== Experiment 3: SMOTE (train-fold only) ===\")\n",
    "print(smote_df)\n"
   ]
  },
