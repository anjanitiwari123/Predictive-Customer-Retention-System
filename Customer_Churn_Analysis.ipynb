   "source": [
    "outlier_rows = []\n",
    "for c in num_cols:\n",
    "    q1, q3 = df[c].quantile(0.25), df[c].quantile(0.75)\n",
    "    iqr = q3 - q1\n",
    "    lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr\n",
    "    n_out = ((df[c] < lo) | (df[c] > hi)).sum()\n",
    "    outlier_rows.append([c, round(lo,2), round(hi,2), n_out, round(n_out/len(df)*100, 2)])\n",
    "outlier_df = pd.DataFrame(outlier_rows, columns=[\"feature\",\"lower_bound\",\"upper_bound\",\"outlier_count\",\"outlier_pct\"])\n",
    "outlier_df\n"
   ]
  },
