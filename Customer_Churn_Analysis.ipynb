   "source": [
    "def cv_with_smote(model_ctor, scale, X_data, y_data, n_splits=5):\n",
    "    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=RANDOM_STATE)\n",
    "    aucs, f1s = [], []\n",
    "    for tr_idx, va_idx in skf.split(X_data, y_data):\n",
    "        Xtr_fold, Xva_fold = X_data.iloc[tr_idx], X_data.iloc[va_idx]\n",
    "        ytr_fold, yva_fold = y_data.iloc[tr_idx], y_data.iloc[va_idx]\n",
    "        m = evaluate_with_smote(model_ctor(), scale, Xtr_fold, ytr_fold, Xva_fold, yva_fold, numerical_features, categorical_features)\n",
    "        aucs.append(m[\"roc_auc\"]); f1s.append(m[\"f1\"])\n",
    "    return np.array(aucs), np.array(f1s)\n",
    "\n",
    "candidates = {\n",
    "    \"Logistic Regression\": (lambda: LogisticRegression(max_iter=2000, random_state=RANDOM_STATE), True),\n",
    "    \"Gradient Boosting\": (lambda: GradientBoostingClassifier(random_state=RANDOM_STATE), False),\n",
    "    \"XGBoost\": ((lambda: XGBClassifier(n_estimators=300, random_state=RANDOM_STATE, eval_metric=\"logloss\"))\n",
    "                if XGB_AVAILABLE else (lambda: HistGradientBoostingClassifier(random_state=RANDOM_STATE)), False),\n",
    "}\n",
    "cv_stability = {}\n",
    "for name, (ctor, scale) in candidates.items():\n",
    "    aucs, f1s = cv_with_smote(ctor, scale, X_train, y_train)\n",
    "    cv_stability[name] = {\"roc_auc_mean\": aucs.mean(), \"roc_auc_std\": aucs.std(),\n",
    "                           \"f1_mean\": f1s.mean(), \"f1_std\": f1s.std()}\n",
    "    print(name, {k: round(v,4) for k,v in cv_stability[name].items()})\n"
   ]
  },
