   "source": [
    "def cv_score(num_feats, cat_feats, model, scale, X_data, y_data):\n",
    "    pipe = build_pipeline(model, scale, num_feats, cat_feats)\n",
    "    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
    "    scores = cross_validate(pipe, X_data, y_data, cv=cv, scoring=[\"roc_auc\", \"f1\"])\n",
    "    return scores[\"test_roc_auc\"].mean(), scores[\"test_f1\"].mean()\n",
    "\n",
    "for name, (model, scale) in [(\"Logistic Regression\", get_models()[\"Logistic Regression\"]),\n",
    "                              (\"Gradient Boosting\", get_models()[\"Gradient Boosting\"])]:\n",
    "    auc_with, f1_with = cv_score(numerical_features_full, categorical_features_full, clone(model), scale, X_train, y_train)\n",
    "    auc_without, f1_without = cv_score(raw_num, raw_cat, clone(model), scale, X_train, y_train)\n",
    "    print(f\"{name}: WITH engineered    roc_auc={auc_with:.4f}  f1={f1_with:.4f}\")\n",
    "    print(f\"{name}: WITHOUT engineered roc_auc={auc_without:.4f}  f1={f1_without:.4f}\")\n"
   ]
  },
